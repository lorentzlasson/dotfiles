#!/usr/bin/env bash
set -euo pipefail

peer="$1"
message="$2"

agents=$(claude agents --json)

pids=$(jq -r --arg name "$peer" '.[] | select(.name == $name) | .pid' <<< "$agents")
if [ -z "$pids" ]; then
  echo "notify-peer: no running session named '$peer'" >&2
  exit 1
fi
if [ "$(wc -l <<< "$pids")" -gt 1 ]; then
  echo "notify-peer: multiple running sessions named '$peer' (pids: $(tr '\n' ' ' <<< "$pids")) — rename one and retry" >&2
  exit 1
fi
pid="$pids"

sender=""
p=$PPID
while [ -n "$p" ] && [ "$p" -gt 1 ]; do
  sender=$(jq -r --argjson pid "$p" '.[] | select(.pid == $pid) | .name' <<< "$agents")
  [ -n "$sender" ] && break
  p=$(ps -o ppid= -p "$p" | tr -d ' ')
done

message=$(tr '\n\r' '  ' <<< "$message")
if [ -n "$sender" ]; then
  message="[from $sender] $message [to reply, run the shell command: notify-peer $sender \"<your reply>\"]"
fi

tty=$(ps -o tty= -p "$pid" | tr -d ' ')
target=$(tmux list-panes -a -F '#{pane_tty} #{session_name}:#{window_index}.#{pane_index}' | awk -v tty="/dev/$tty" '$1 == tty { print $2 }')
if [ -z "$target" ]; then
  echo "notify-peer: could not resolve tmux pane for '$peer' (pid $pid, tty $tty)" >&2
  exit 1
fi

tmux send-keys -t "$target" -l -- "$message"
sleep 0.1
tmux send-keys -t "$target" Enter
